name = "cyber-tetris-api"
main = "worker.js"
compatibility_date = "2026-11-19"

[[d1_databases]]
binding = "DB"
database_name = "cyber-tetris"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

# Recommended: create a KV namespace and put its ID here for basic submission throttling.
# [[kv_namespaces]]
# binding = "RATE_LIMITS"
# id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
# Replace with your GitHub Pages origin, e.g. https://username.github.io
ALLOWED_ORIGIN = "https://YOUR_GITHUB_PAGES_ORIGIN"
